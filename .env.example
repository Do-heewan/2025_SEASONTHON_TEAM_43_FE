# 이 파일을 복사해 .env 를 만들고 값을 채워주세요.  (cp .env.example .env)
# EXPO_PUBLIC_* 값은 번들 시점에 코드에 박히므로, 수정 후에는 `npx expo start -c` 로 캐시를 비우고 재시작해야 합니다.

# Spring 백엔드 주소 (끝에 / 없이)
#  - 배포 서버:           https://<your-backend-host>
#  - PC 로컬 + 에뮬레이터: http://10.0.2.2:8080
#  - PC 로컬 + 실기기:     http://<PC의 내부 IP>:8080   (같은 Wi-Fi 필요)
EXPO_PUBLIC_API_BASE_URL=

# FastAPI 추천 서버의 /recommend 엔드포인트 전체 URL (lat, lng 는 앱이 쿼리로 붙임)
EXPO_PUBLIC_FASTAPI_BASE_URL=https://<your-fastapi-host>/recommend

# Kakao Developers > 내 애플리케이션 > 앱 키
EXPO_PUBLIC_KAKAO_MAP_JS_KEY=
EXPO_PUBLIC_KAKAO_REST_API_KEY=
EXPO_PUBLIC_NATIVE_APP_KEY=
